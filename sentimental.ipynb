   "id": "8325ae5f-6d8c-4db2-b821-52b2113e97eb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Generate Mock Dirty Dataset\n",
    "np.random.seed(42)\n",
    "n = 100\n",
    "data = {\n",
    "    'Age': np.random.randint(18, 70, n).astype(float),\n",
    "    'Income': np.random.normal(50000, 15000, n),\n",
    "    'Gender': np.random.choice(['Male', 'Female', 'Other'], n),\n",
    "    'Spending_Score': np.random.randint(1, 100, n)\n",
    "}\n",
    "df_dirty = pd.DataFrame(data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "9e384848-82e4-467c-8f56-1d0d6e5988ba",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Inject missing values and extreme outliers\n",
    "df_dirty.loc[np.random.choice(df_dirty.index, 10), 'Age'] = np.nan\n",
    "df_dirty.loc[np.random.choice(df_dirty.index, 15), 'Income'] = np.nan\n",
    "df_dirty.loc[0, 'Income'] = 500000  # Extreme outlier\n",
    "df_dirty.loc[1, 'Age'] = 150        # Impossible age outlier\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 83,
   "id": "315433b0-02f9-4ef4-8a21-3e88295c660a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Rows after outlier removal: 78\n"
     ]
    }
   ],
   "source": [
    "# 2. Outlier Detection & Removal (IQR Method)\n",
    "def remove_outliers_iqr(df, column):\n",
    "    Q1 = df[column].quantile(0.25)\n",
    "    Q3 = df[column].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "    return df[(df[column] >= lower_bound) & (df[column] <= upper_bound)]\n",
    "\n",
    "df_clean = df_dirty.copy()\n",
    "df_clean = remove_outliers_iqr(df_clean, 'Income')\n",
    "df_clean = remove_outliers_iqr(df_clean, 'Age')\n",
    "print(f\"Rows after outlier removal: {len(df_clean)}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 84,
   "id": "b97fdce8-45f9-4835-b580-801e882bf2ce",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Data cleaning and preprocessing complete.\n"
     ]
    }
   ],
   "source": [
    "# 3. Production-Grade Preprocessing Pipeline\n",
    "numeric_features = ['Age', 'Income', 'Spending_Score']\n",
    "categorical_features = ['Gender']\n",
    "\n",
    "numeric_transformer = Pipeline(steps=[\n",
    "    ('imputer', SimpleImputer(strategy='median')),\n",
    "    ('scaler', StandardScaler())\n",
    "])\n",
    "\n",
    "categorical_transformer = Pipeline(steps=[\n",
    "    ('imputer', SimpleImputer(strategy='most_frequent')),\n",
    "    ('onehot', OneHotEncoder(handle_unknown='ignore'))\n",
    "])\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('num', numeric_transformer, numeric_features),\n",
    "        ('cat', categorical_transformer, categorical_features)\n",
    "    ])\n",
    "\n",
    "# Fit and transform the cleaned data\n",
    "df_processed = preprocessor.fit_transform(df_clean)\n",
    "print(\"✅ Data cleaning and preprocessing complete.\")"
   ]
  },
