    "    'Sleep_Hours': np.random.uniform(4, 9, n),\n",
    "    'Exam_Score': np.random.normal(75, 10, n)\n",
    "})\n",
    "# Inject realistic correlation\n",
    "df_eda['Exam_Score'] = df_eda['Study_Hours'] * 5 + df_eda['Sleep_Hours'] * 2 + np.random.normal(0, 5, n)\n",
    "\n",
    "# 2. Descriptive Summary Statistics (FIXED)\n",
    "# describe() gives: count, mean, std, min, 25%, 50%, 75%, max\n",
    "# We manually add variance since describe() does not include it\n",
    "desc = df_eda.describe().loc[['mean', '50%']]\n",
    "desc.index = ['Mean', 'Median']\n",
    "\n",
    "# Compute variance separately and append\n",
    "variance_row = pd.DataFrame([df_eda.var()], columns=df_eda.columns, index=['Variance'])\n",
    "summary_stats = pd.concat([desc, variance_row])\n",
    "\n",
    "print(\"📊 Summary Statistics:\\n\", summary_stats, \"\\n\")\n"
