    "# LEVEL 1 - TASK 2: Data Cleaning and Preprocessing\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
    "\n",
    "# Load data\n",
    "df_clean = pd.read_csv('Sentiment_dataset[1].csv')\n",
    "\n",
    "# 1. Handle missing data (Imputation/Removal)\n",
    "# Drop rows where core text or sentiment is missing\n",
    "df_clean = df_clean.dropna(subset=['Text', 'Sentiment'])\n",
    "\n",
    "# Impute missing numerical values (Retweets) using the median\n",
    "# ✅ FIX: Removed the duplicate line and avoided inplace=True to prevent the FutureWarning\n",
    "df_clean['Retweets'] = df_clean['Retweets'].fillna(df_clean['Retweets'].median())\n",
    "\n",
    "# 2. Detect and remove outliers (using IQR for Likes)\n",
    "Q1 = df_clean['Likes'].quantile(0.25)\n",
    "Q3 = df_clean['Likes'].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "df_clean = df_clean[(df_clean['Likes'] >= lower_bound) & (df_clean['Likes'] <= upper_bound)]\n",
    "\n",
    "# 3. Convert categorical variables (One-Hot Encoding for Platform)\n",
    "df_encoded = pd.get_dummies(df_clean, columns=['Platform'], drop_first=True)\n",
    "\n",
    "# 4. Normalize numerical data (Standard Scaling for Retweets/Likes)\n",
    "scaler = StandardScaler()\n",
    "df_encoded[['Retweets_scaled', 'Likes_scaled']] = scaler.fit_transform(df_encoded[['Retweets', 'Likes']])\n",
    "\n",
    "print(\"✅ Data Cleaning and Preprocessing Complete!\")\n",
    "display(df_encoded.head())"
   ]
  },
