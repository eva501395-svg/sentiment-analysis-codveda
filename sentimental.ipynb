    "import numpy as np\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense, Dropout, Input\n",
    "from tensorflow.keras.optimizers import Adam\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# 1. Generate Synthetic Multi-Class Structured Data\n",
    "np.random.seed(42)\n",
    "n_samples = 1000\n",
    "X_nn = np.random.randn(n_samples, 20) # 20 features\n",
    "# Create 3 classes based on non-linear combinations\n",
    "y_nn_probs = np.exp(X_nn[:, :3] * np.array([1, -1, 0.5]))\n",
    "y_nn_probs /= y_nn_probs.sum(axis=1, keepdims=True)\n",
    "y_nn = np.array([np.random.choice([0, 1, 2], p=p) for p in y_nn_probs])\n",
    "\n",
    "# 2. Preprocess & Scale\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_nn, y_nn, test_size=0.2, random_state=42)\n",
    "scaler = StandardScaler()\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "# 3. Build Sequential Neural Network\n",
    "model = Sequential([\n",
    "    Input(shape=(20,)),               # Input layer\n",
    "    Dense(64, activation='relu'),     # Hidden layer 1\n",
    "    Dropout(0.3),                     # Dropout for regularization\n",
    "    Dense(32, activation='relu'),     # Hidden layer 2\n",
    "    Dropout(0.2),                     # Dropout\n",
    "    Dense(3, activation='softmax')    # Output layer (3 classes)\n",
    "])\n",
    "\n",
    "# 4. Compile the Model\n",
    "model.compile(optimizer=Adam(learning_rate=0.001),\n",
    "              loss='sparse_categorical_crossentropy',\n",
    "              metrics=['accuracy'])\n",
    "\n",
    "# 5. Train the Model\n",
    "print(\"🧠 Training Neural Network...\")\n",
    "history = model.fit(X_train_scaled, y_train, \n",
    "                    epochs=5, \n",
    "                    batch_size=32, \n",
    "                    validation_split=0.2, \n",
    "                    verbose=1)\n",
    "\n",
    "# 6. Evaluate and Print Trends\n",
    "test_loss, test_acc = model.evaluate(X_test_scaled, y_test, verbose=0)\n",
    "print(f\"\\n✅ Final Test Accuracy: {test_acc:.4f}\")\n",
    "print(\"📉 Training Loss Trend (per epoch):\", [f\"{loss:.4f}\" for loss in history.history['loss']])"
   ]
